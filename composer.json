{
    "name": "darvis/laravel-google-translate",
    "description": "Translate text, HTML and Eloquent models in Laravel with the Google Cloud Translation API, with one row per locale linked through a pid column.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://arviddejong.github.io/laravel-google-translate/",
    "keywords": [
        "laravel",
        "google-translate",
        "translation",
        "i18n",
        "localization",
        "multilingual",
        "eloquent",
        "google-cloud",
        "laravel-boost"
    ],
    "authors": [
        {
            "name": "Arvid de Jong",
            "email": "info@arvid.nl"
        }
    ],
    "support": {
        "issues": "https://github.com/ArvidDeJong/laravel-google-translate/issues",
        "source": "https://github.com/ArvidDeJong/laravel-google-translate",
        "docs": "https://arviddejong.github.io/laravel-google-translate/"
    },
    "require": {
        "php": "^8.2",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Darvis\\LaravelGoogleTranslate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Darvis\\LaravelGoogleTranslate\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest tests",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Darvis\\LaravelGoogleTranslate\\GoogleTranslateServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
